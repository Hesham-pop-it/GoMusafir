# GoMusafir Mobile App — Environment Variables
# Copy this file to .env and fill in your values from the Firebase Console

# Firebase Client SDK (These are public, safe for app bundle)
EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=go-musafir.firebaseapp.com
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://go-musafir-default-rtdb.europe-west1.firebasedatabase.app
EXPO_PUBLIC_FIREBASE_PROJECT_ID=go-musafir
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=go-musafir.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id_here

# Development: set to "true" to connect to local Firebase emulators
EXPO_PUBLIC_USE_EMULATOR=false
