{
  "expo": {
    "newArchEnabled": false,
    "name": "GoMusafir",
    "slug": "GoMusafir",
    "scheme": "gomusafir",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "appleTeamId": "W2G7J23TZQ",
      "googleServicesFile": "./GoogleService-Info.plist",
      "bundleIdentifier": "com.popit.GoMusafir",
      "associatedDomains": [
        "applinks:app.gomusafir.app",
        "applinks:www.app.gomusafir.app",
        "applinks:join.gomusafir.app",
        "applinks:www.join.gomusafir.app",
        "webcredentials:app.gomusafir.app",
        "webcredentials:www.app.gomusafir.app",
        "webcredentials:join.gomusafir.app",
        "webcredentials:www.join.gomusafir.app"
      ],
      "entitlements": {
        "com.apple.developer.associated-domains": [
          "applinks:app.gomusafir.app",
          "applinks:www.app.gomusafir.app",
          "applinks:join.gomusafir.app",
          "applinks:www.join.gomusafir.app",
          "webcredentials:app.gomusafir.app",
          "webcredentials:www.app.gomusafir.app",
          "webcredentials:join.gomusafir.app",
          "webcredentials:www.join.gomusafir.app"
        ]
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow GoMusafir to access your location to show nearby places and provide navigation.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow GoMusafir to access your location to provide navigation and updates even when the app is in the background.",
        "NSLocationAlwaysUsageDescription": "Allow GoMusafir to access your location to provide navigation and updates even when the app is in the background.",
        "NSMicrophoneUsageDescription": "Allow GoMusafir to access your microphone for voice chat.",
        "UIBackgroundModes": [
          "remote-notification",
          "location",
          "audio",
          "voip",
          "remote-notification",
          "location",
          "audio",
          "voip"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#1A1E21"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDng5xhvMyRXSTHDmBkLbn_3uHtM7doueI"
        }
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.popit.GoMusafir",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.app.gomusafir.app",
              "pathPrefix": "/link"
            },
            {
              "scheme": "https",
              "host": "app.gomusafir.app",
              "pathPrefix": "/link"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#1A1E21"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "visible": true,
          "style": "light",
          "backgroundColor": "#1A1E21"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.24"
          },
          "ios": {
            "deploymentTarget": "16.4",
            "useFrameworks": "static"
          }
        }
      ],
      "@react-native-firebase/app",
      "./plugins/withFirebaseSwiftFix",
      "./plugins/withXcodeBuildSettings",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow GoMusafir to access your camera to scan QR codes."
        }
      ],
      "@react-native-firebase/messaging",
      [
        "@livekit/react-native-expo-plugin",
        {
          "ios": {
            "microphonePermission": "Allow GoMusafir to access your microphone for voice chat."
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-audio",
      [
        "react-native-maps",
        {
          "iosGoogleMapsApiKey": "AIzaSyDng5xhvMyRXSTHDmBkLbn_3uHtM7doueI"
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.popit.GoMusafir",
          "bundleIdentifier": "com.popit.GoMusafir.ExpoWidgetsTarget",
          "widgets": [
            {
              "name": "MyWidget",
              "displayName": "My Widget",
              "description": "A sample home screen widget",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium", "systemLarge"],
                "contentMarginsDisabled": true
              }
            },
            {
              "name": "MyLiveActivity",
              "displayName": "Voice Activity",
              "description": "Shows live voice chat status and controls"
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "619ef28d-9e0f-4e5c-8b41-5f21a2a1fd65"
      }
    }
  }
}
