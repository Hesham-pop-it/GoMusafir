{
  "expo": {
    "name": "GoMusafir",
    "slug": "GoMusafir",
    "scheme": "gomusafir",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1E21"
    },
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "AIzaSyDng5xhvMyRXSTHDmBkLbn_3uHtM7doueI"
      },
      "bundleIdentifier": "com.popit.GoMusafir"
    },
    "android": {
      "edgeToEdgeEnabled": false,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#1A1E21"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDng5xhvMyRXSTHDmBkLbn_3uHtM7doueI"
        }
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.popit.GoMusafir"
    },
    "androidNavigationBar": {
      "backgroundColor": "#1A1E21",
      "barStyle": "light-content"
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow GoMusafir to access your camera to scan QR codes."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging"
    ],
    "extra": {
      "eas": {
        "projectId": "619ef28d-9e0f-4e5c-8b41-5f21a2a1fd65"
      }
    }
  }
}
