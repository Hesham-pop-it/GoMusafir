{
  "expo": {
    "name": "GoMusafir",
    "slug": "GoMusafir",
    "scheme": "gomusafir",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1E21"
    },
    "ios": {
      "supportsTablet": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "config": {
        "googleMapsApiKey": "AIzaSyDng5xhvMyRXSTHDmBkLbn_3uHtM7doueI"
      },
"bundleIdentifier": "com.popit.GoMusafir",
      "associatedDomains": ["applinks:gomusafir.app"],
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow GoMusafir to access your location to show nearby places and provide navigation.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow GoMusafir to access your location to provide navigation and updates even when the app is in the background.",
        "NSLocationAlwaysUsageDescription": "Allow GoMusafir to access your location to provide navigation and updates even when the app is in the background.",
        "UIBackgroundModes": [
          "remote-notification",
          "location"
        ]
      }
    },
    "android": {
      "edgeToEdgeEnabled": false,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#1A1E21"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDng5xhvMyRXSTHDmBkLbn_3uHtM7doueI"
        }
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.popit.GoMusafir",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.gomusafir.app",
              "pathPrefix": "/link"
            },
            {
              "scheme": "https",
              "host": "gomusafir.app",
              "pathPrefix": "/link"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "androidNavigationBar": {
      "backgroundColor": "#1A1E21",
      "barStyle": "light-content"
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.24"
          },
          "ios": {
            "deploymentTarget": "15.1",
            "useFrameworks": "static"
          }
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow GoMusafir to access your camera to scan QR codes."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "@livekit/react-native-expo-plugin",
      "expo-sqlite",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "619ef28d-9e0f-4e5c-8b41-5f21a2a1fd65"
      }
    }
  }
}