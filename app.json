{
  "expo": {
    "newArchEnabled": false,
    "name": "GoMusafir",
    "slug": "gomusafir",
    "scheme": "gomusafir",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "appleTeamId": "W2G7J23TZQ",
      "googleServicesFile": "./GoogleService-Info.plist",
      "bundleIdentifier": "com.popit.GoMusafir",
      "associatedDomains": [
        "applinks:app.gomusafir.app",
        "applinks:www.app.gomusafir.app",
        "applinks:join.gomusafir.app",
        "applinks:www.join.gomusafir.app",
        "webcredentials:app.gomusafir.app",
        "webcredentials:www.app.gomusafir.app",
        "webcredentials:join.gomusafir.app",
        "webcredentials:www.join.gomusafir.app"
      ],
      "entitlements": {
        "com.apple.developer.associated-domains": [
          "applinks:app.gomusafir.app",
          "applinks:www.app.gomusafir.app",
          "applinks:join.gomusafir.app",
          "applinks:www.join.gomusafir.app",
          "webcredentials:app.gomusafir.app",
          "webcredentials:www.app.gomusafir.app",
          "webcredentials:join.gomusafir.app",
          "webcredentials:www.join.gomusafir.app"
        ]
      },
      "infoPlist": {
        "UIRequiresFullScreen": true,
        "NSLocationWhenInUseUsageDescription": "Allow GoMusafir to access your location to show nearby places and provide navigation.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow GoMusafir to access your location to provide navigation and updates even when the app is in the background.",
        "NSLocationAlwaysUsageDescription": "Allow GoMusafir to access your location to provide navigation and updates even when the app is in the background.",
        "NSMicrophoneUsageDescription": "Allow GoMusafir to access your microphone for voice chat.",
        "NSCameraUsageDescription": "Allow GoMusafir to access your camera to take photos and scan QR codes.",
        "NSPhotoLibraryUsageDescription": "Allow GoMusafir to access your photos to save the QR code.",
        "NSPhotoLibraryAddUsageDescription": "Allow GoMusafir to save photos.",
        "UIBackgroundModes": [
          "location",
          "remote-notification",
          "audio",
          "voip"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#1A1E21"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDng5xhvMyRXSTHDmBkLbn_3uHtM7doueI"
        }
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.popit.GoMusafir",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.app.gomusafir.app",
              "pathPrefix": "/link"
            },
            {
              "scheme": "https",
              "host": "app.gomusafir.app",
              "pathPrefix": "/link"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Allow GoMusafir to access your photos to save the QR code.",
          "savePhotosPermission": "Allow GoMusafir to save photos.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#1A1E21"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "visible": true,
          "style": "light",
          "backgroundColor": "#1A1E21"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.24"
          },
          "ios": {
            "deploymentTarget": "16.4",
            "useFrameworks": "static"
          }
        }
      ],
      "@react-native-firebase/app",
      "./plugins/withFirebaseSwiftFix",
      "./plugins/withXcodeBuildSettings",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow GoMusafir to access your camera to scan QR codes."
        }
      ],
      "@react-native-firebase/messaging",
      [
        "@livekit/react-native-expo-plugin",
        {
          "ios": {
            "microphonePermission": "Allow GoMusafir to access your microphone for voice chat."
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-audio",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow GoMusafir to access your location to provide navigation and updates even when the app is in the background.",
          "locationAlwaysPermission": "Allow GoMusafir to access your location to provide navigation and updates even when the app is in the background.",
          "locationWhenInUsePermission": "Allow GoMusafir to access your location to show nearby places and provide navigation.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "react-native-maps",
        {
          "iosGoogleMapsApiKey": "AIzaSyDng5xhvMyRXSTHDmBkLbn_3uHtM7doueI"
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.popit.GoMusafir",
          "bundleIdentifier": "com.popit.GoMusafir.ExpoWidgetsTarget",
          "widgets": [
            {
              "name": "MyWidget",
              "displayName": "My Widget",
              "description": "A sample home screen widget",
              "ios": {
                "supportedFamilies": [
                  "systemMedium"
                ],
                "contentMarginsDisabled": true
              }
            },
            {
              "name": "MyLiveActivity",
              "displayName": "Voice Activity",
              "description": "Shows live voice chat status and controls"
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4a4bce63-dc10-420a-97dc-c38b674bb480",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.popit.GoMusafir.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.popit.GoMusafir"
                    ]
                  }
                }
              ]
            }
          }
        }
      },
      "expo-navigation-bar": {
        "style": "light"
      }
    },
    "owner": "pop-its-team"
  }
}
