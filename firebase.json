{
  "database": {
    "rules": "database.rules.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": [
    {
      "target": "website",
      "public": "GoMusafir-Website/out",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "**/**.txt"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "cleanUrls": true,
      "trailingSlash": false
    },
    {
      "target": "api",
      "public": "public",
      "rewrites": [
        {
          "source": "**",
          "function": {
            "functionId": "stripeWebhookHandler",
            "region": "europe-west1"
          }
        }
      ]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "database": {
      "port": 9000
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "firestore": {
      "port": 8080
    }
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "react-native": {
    "messaging_ios_foreground_presentation_options": []
  }
}
