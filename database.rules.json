{
  "rules": {
    "users": {
        "$uid": {
           ".read": "$uid === auth.uid || root.child('orgs').child(auth.token.orgId).child('staff').child(auth.uid).exists() || root.child('orgs').child(root.child('users').child(auth.uid).child('staff_org_id').val()).child('staff').child(auth.uid).exists() || root.child('trips_participants').child(root.child('users').child($uid).child('current_trip').val()).child(auth.uid).exists()",
           ".write": "$uid === auth.uid",
           "full_name": {
              ".read": "auth.uid !== null"
           },
           "participant_visibility": {
              ".read": "auth.uid !== null"
           },
           "profile": {
              ".read": "auth.uid !== null", 
              ".write": "$uid === auth.uid"
           },
           "photo_url": {
              ".read": "auth.uid !== null",
              ".write": "$uid === auth.uid"
           },
           "photo": {
              ".read": "auth.uid !== null",
              ".write": "$uid === auth.uid"
           },
           "image": {
              ".read": "auth.uid !== null",
              ".write": "$uid === auth.uid"
           },
           "profile_photo": {
              ".read": "auth.uid !== null",
              ".write": "$uid === auth.uid"
           }
        }
    },
    "orgs": {
        ".indexOn": ["stripe_customer_id"],
        "$orgId": {
           "trips": {
              ".read": "root.child('orgs').child($orgId).child('staff').child(auth.uid).exists()",
              "$tripId": {
                 ".read": "(root.child('trips_participants').child($tripId).child(auth.uid).exists() && root.child('orgs').child($orgId).child('trips').child($tripId).child('status').val() === 'active') || root.child('orgs').child($orgId).child('staff').child(auth.uid).exists()",
                 ".write": "root.child('orgs').child($orgId).child('staff').child(auth.uid).val() === 'admin' || root.child('orgs').child($orgId).child('staff').child(auth.uid).val() === 'co-host' || root.child('orgs').child($orgId).child('staff').child(auth.uid).val() === 'manager'",
                 "visibility_config": {
                    ".write": "root.child('orgs').child($orgId).child('staff').child(auth.uid).exists()"
                 }
              }
           },
           "dashboard_stats": {
              ".read": "root.child('orgs').child($orgId).child('staff').child(auth.uid).exists() || (root.child('users').child(auth.uid).child('staff_org_id').val() == $orgId)",
              ".write": "false"
           },
           "checkout_sessions": {
              ".read": "root.child('orgs').child($orgId).child('staff').child(auth.uid).exists() || (root.child('users').child(auth.uid).child('staff_org_id').val() == $orgId)",
              ".write": "false"
           },
           "staff": {
              ".read": "root.child('orgs').child($orgId).child('staff').child(auth.uid).exists() || (root.child('users').child(auth.uid).child('staff_org_id').val() == $orgId) || (root.child('trips_orgs').child(root.child('users').child(auth.uid).child('current_trip').val()).val() == $orgId)",
              ".write": "root.child('orgs').child($orgId).child('staff').child(auth.uid).val() === 'admin' || root.child('orgs').child($orgId).child('staff').child(auth.uid).val() === 'co-host'"
           },
           "metadata": {
              ".read": "true"
           },
           "consents": {
              ".read": "root.child('orgs').child($orgId).child('staff').child(auth.uid).exists()",
              ".write": "auth.uid !== null"
           },
           "payments": {
              ".read": "root.child('orgs').child($orgId).child('staff').child(auth.uid).exists()",
              ".indexOn": ["stripeSessionId"]
           },
           "prepaid_seats": {
              ".read": "root.child('orgs').child($orgId).child('staff').child(auth.uid).exists() || (root.child('users').child(auth.uid).child('staff_org_id').val() == $orgId)",
              ".write": "root.child('orgs').child($orgId).child('staff').child(auth.uid).val() === 'admin' || root.child('orgs').child($orgId).child('staff').child(auth.uid).val() === 'co-host'"
           }
        }
    },
    "trips_participants": {
         "$tripId": {
            ".read": "auth.uid !== null && ((root.child('trips_participants').child($tripId).child(auth.uid).exists() && root.child('orgs').child(root.child('trips_orgs').child($tripId).val()).child('trips').child($tripId).child('status').val() === 'active') || root.child('orgs').child(root.child('trips_orgs').child($tripId).val()).child('staff').child(auth.uid).exists() || root.child('orgs').child(auth.token.orgId).child('staff').child(auth.uid).exists() || root.child('orgs').child(root.child('users').child(auth.uid).child('staff_org_id').val()).child('staff').child(auth.uid).exists())",
           "$uid": {
              ".write": false
           }
        }
    },
    "trips_active": {
        "$orgId": {
           "$tripId": {
              "locations": {
                 ".read": "(root.child('trips_participants').child($tripId).child(auth.uid).exists() && root.child('orgs').child($orgId).child('trips').child($tripId).child('status').val() === 'active') || root.child('orgs').child($orgId).child('staff').child(auth.uid).exists()",
                 "$uid": {
                    ".write": "auth.uid === $uid"
                 }
              },
              "notifications": {
                 "$targetUid": {
                    ".read": "auth.uid === $targetUid || root.child('orgs').child($orgId).child('staff').child(auth.uid).exists()",
                    ".write": "auth.uid !== null"
                 }
              },
              "chat": {
                 ".read": "(root.child('trips_participants').child($tripId).child(auth.uid).exists() && root.child('orgs').child($orgId).child('trips').child($tripId).child('status').val() === 'active') || root.child('orgs').child($orgId).child('staff').child(auth.uid).exists()",
                 ".write": "(root.child('trips_participants').child($tripId).child(auth.uid).exists() && root.child('orgs').child($orgId).child('trips').child($tripId).child('status').val() === 'active') || root.child('orgs').child($orgId).child('staff').child(auth.uid).exists()",
                 ".indexOn": ["timestamp"],
                 "$messageId": {
                    ".validate": "newData.hasChildren(['sender_id', 'timestamp']) && (newData.hasChild('text') || newData.hasChild('type')) && (newData.child('sender_id').val() == auth.uid || root.child('orgs').child($orgId).child('staff').child(auth.uid).exists())"
                 }
              },
              "read_pointers": {
                 ".read": "(root.child('trips_participants').child($tripId).child(auth.uid).exists() && root.child('orgs').child($orgId).child('trips').child($tripId).child('status').val() === 'active') || root.child('orgs').child($orgId).child('staff').child(auth.uid).exists()",
                 "$uid": {
                    ".write": "auth.uid === $uid"
                 }
              },
              "templates": {
                 ".read": "(root.child('trips_participants').child($tripId).child(auth.uid).exists() && root.child('orgs').child($orgId).child('trips').child($tripId).child('status').val() === 'active') || root.child('orgs').child($orgId).child('staff').child(auth.uid).exists()",
                 ".write": "root.child('orgs').child($orgId).child('staff').child(auth.uid).exists()"
              },
              "location_permissions": {
                 ".read": "(root.child('trips_participants').child($tripId).child(auth.uid).exists() && root.child('orgs').child($orgId).child('trips').child($tripId).child('status').val() === 'active') || root.child('orgs').child($orgId).child('staff').child(auth.uid).exists()",
                 "$targetUid": {
                    "$requesterUid": {
                       ".write": "auth.uid === $targetUid"
                    }
                 }
              },
               "voice_channel": {
                   ".read": "auth != null && ((root.child('trips_participants').child($tripId).child(auth.uid).exists() && root.child('orgs').child($orgId).child('trips').child($tripId).child('status').val() === 'active') || auth.token.orgId == $orgId || root.child('orgs').child($orgId).child('staff').child(auth.uid).exists() || root.child('users').child(auth.uid).child('staff_org_id').val() == $orgId)",
                   ".write": "auth != null && ( (auth.token.orgId == $orgId && (auth.token.role == 'admin' || auth.token.role == 'manager' || auth.token.role == 'co-host')) || root.child('orgs').child($orgId).child('staff').child(auth.uid).exists() || root.child('users').child(auth.uid).child('staff_org_id').val() == $orgId )",
                   "activeSpeaker": {
                       ".write": "auth != null && ((root.child('trips_participants').child($tripId).child(auth.uid).exists() && root.child('orgs').child($orgId).child('trips').child($tripId).child('status').val() === 'active') || root.child('orgs').child($orgId).child('staff').child(auth.uid).exists())"
                   },
                   "presence": {
                       ".read": "auth != null",
                       ".write": "auth != null"
                   },
                   "app_presence": {
                       ".read": "auth != null",
                       ".write": "auth != null"
                   },
                   "active_hosts": {
                       ".read": "auth != null",
                       ".write": "auth != null"
                   }
                },
               "voice_presence": {
                   ".read": "auth != null",
                   ".write": "auth != null"
               },
                "pinned_location": {
                   ".read": "(root.child('trips_participants').child($tripId).child(auth.uid).exists() && root.child('orgs').child($orgId).child('trips').child($tripId).child('status').val() === 'active') || root.child('orgs').child($orgId).child('staff').child(auth.uid).exists()",
                   ".write": "root.child('orgs').child($orgId).child('staff').child(auth.uid).exists()"
                },
               "safety_point": {
                  ".read": "(root.child('trips_participants').child($tripId).child(auth.uid).exists() && root.child('orgs').child($orgId).child('trips').child($tripId).child('status').val() === 'active') || root.child('orgs').child($orgId).child('staff').child(auth.uid).exists()",
                  ".write": "root.child('orgs').child($orgId).child('staff').child(auth.uid).exists()"
               }
           }
        }
    },
    "invites": {
        "$inviteCode": {
           ".read": "auth.uid !== null"
        }
    },
    "trips_orgs": {
        ".read": "auth.uid !== null"
    },
    "system_logs": {
        ".read": false,
        ".write": false
    },
    "account_deletion_requests": {
      "$request_id": {
        ".read": false,
        ".write": "!data.exists() && newData.exists() && newData.hasChildren(['name', 'email', 'timestamp'])"
      }
    }
  }
}
