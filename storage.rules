rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Uploads are authorized by backend functions using Auth and Realtime Database.
    // Signed, create-only uploads bypass client rules; all direct client writes are denied.
    match /trips/{fileName} {
      allow read: if true;
    }
    // Passport and visa copies are only ever read or written by the backend (admin SDK).
    match /passport_docs/{allPaths=**} {
      allow read, write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
