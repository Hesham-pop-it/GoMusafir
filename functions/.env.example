# GoMusafir Cloud Functions — Environment Variables
# These are set via Firebase environment config, NOT stored in code (S35 - secrets not in code)
# Set these using: firebase functions:secrets:set SECRET_NAME

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# PII Encryption (AES-256 key — 32 bytes hex string)
# In production this wraps Google Cloud KMS — this is only for local emulator testing
DEV_ENCRYPTION_KEY=generate_a_64_char_hex_string_here
